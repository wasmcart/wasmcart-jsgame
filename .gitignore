# Build intermediates
obj/

# ASAN/debug cart builds -- 18MB artifacts from build-asan.sh, reproducible
# in one command and useless to anyone else.
build/cart-asan.wasm
build/*-asan.wasm

# Large .wasc builds (pack from jsgames/ source)
examples/space/*.wasc
examples/adventure-ai/*.wasc
examples/space3d/*.wasc

# Host runtime logs written next to a cart when it runs
wasmcart.log
**/wasmcart.log

# OS/editor
.DS_Store
*.swp
*~

# QuickJS source, fetched by setup_quickjs.sh (upstream, not ours to vendor)
vendor/quickjs/
